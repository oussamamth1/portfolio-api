# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Any authenticated Supabase user may now sign up and manage their own portfolio.
# ADMIN_EMAIL is only used once, by supabase_migration_multi_tenant.sql, to assign
# existing pre-migration data to your account; the running app no longer reads it.
ADMIN_EMAIL=you@example.com

# Comma-separated list of origins allowed to call this API (your Vercel site)
CORS_ORIGINS=https://oussamamethnani.vercel.app

PORT=3000
