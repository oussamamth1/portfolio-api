# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Only this Supabase Auth user is allowed to call write endpoints
ADMIN_EMAIL=you@example.com

# Comma-separated list of origins allowed to call this API (your Vercel site)
CORS_ORIGINS=https://oussamamethnani.vercel.app

PORT=3000
